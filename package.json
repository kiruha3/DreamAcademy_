    "@hono/trpc-server": "^0.3.4",
    "@tanstack/vue-query": "^5.45.0",
    "@trpc/client": "^11.0.0-rc.433",
    "@trpc/server": "^11.0.0-rc.433",
    "bcryptjs": "^2.4.3",
    "class-variance-authority": "^0.7.0",
    "dotenv": "^17.4.2",
    "hono": "^4.4.6",
    "jose": "^5.4.1",
    "mysql2": "^3.10.0",
    "nanoid": "^5.0.7",
    "pinia": "^2.1.7",
    "radix-vue": "^1.8.3",
    "superjson": "^2.2.1",
    "tailwindcss-animate": "^1.0.7",
    "vue": "^3.4.27",
