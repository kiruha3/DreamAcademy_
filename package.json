    "autoprefixer": "^10.4.19",
    "drizzle-kit": "^0.22.7",
    "drizzle-orm": "^0.31.2",
    "esbuild": "^0.21.5",
    "postcss": "^8.4.38",
    "tailwindcss": "^3.4.4",
    "tsx": "^4.15.4",
    "typescript": "^5.4.5",
    "vite": "^5.2.13"
